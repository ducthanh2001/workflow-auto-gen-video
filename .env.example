# --- App ---
APP_PASSWORD=change-me
API_PORT=4000
WEB_PORT=3000
BIND_HOST=127.0.0.1
DATA_DIR=/data

# --- Infra ---
DATABASE_URL=postgres://vp:vp@postgres:5432/vp
REDIS_URL=redis://redis:6379

# --- Providers (server side only, never sent to the browser) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
FAL_API_KEY=

# Image service: APIZ (OpenAI-style gateway). Used instead of Gemini once BOTH are filled in.
# It takes no reference pictures, so the character is held by the written character lock only.
APIZ_API_KEY=
APIZ_IMAGE_MODEL=

# --- Optional ---
# IMAGE_PROVIDER=apiz     # force the image service: apiz | gemini (default: apiz if both APIZ_ values are set)
# APIZ_IMAGE_SIZE=1024x576  # 16:9 size sent to APIZ (try 1536x864 for sharper pictures)
# APIZ_BASE_URL=https://api.apiz.vn/v1
# PROVIDERS=mock     # mock providers: no real calls, no cost (also: PROVIDERS=mock docker compose up)
# OCR=off           # skip the OCR text check on generated images
# JOB_BACKOFF_MS=5000
